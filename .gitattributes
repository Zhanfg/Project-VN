# Large binary runtime assets use Git LFS from the beginning.
# Do not migrate generated files; only source/runtime media tracked in Git.

game/background/**/*.png filter=lfs diff=lfs merge=lfs -text
game/background/**/*.jpg filter=lfs diff=lfs merge=lfs -text
game/background/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
